Задание 1 — удаление всех вхождений

import java.util.Arrays;
import java.util.Scanner;

public class Main {

    static int[] removeAll(int[] a, int x) {
        int k = 0;

        for (int i : a) {
            if (i != x) {
                a[k++] = i;
            }
        }

        return Arrays.copyOf(a, k);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] a = new int[n];

        for (int i = 0; i < n; i++) {
            a[i] = sc.nextInt();
        }

        int x = sc.nextInt();

        int[] result = removeAll(a, x);

        for (int i : result) {
            System.out.print(i + " ");
        }
    }
}

Это соответствует заданию про удаление всех вхождений числа без пропусков.  ￼

