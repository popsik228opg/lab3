import java.util.Scanner;

public class Main {

    static double lnFactorial(int n) {
        if (n <= 1) {
            return 0;
        }

        return Math.log(n) + lnFactorial(n - 1);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        System.out.println(lnFactorial(n));
    }
}
