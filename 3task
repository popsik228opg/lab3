import java.io.*;

public class Main {

    static long power(long a, long n, long mod) {
        long result = 1;

        while (n > 0) {
            if (n % 2 == 1) {
                result = result * a % mod;
            }

            a = a * a % mod;
            n /= 2;
        }

        return result;
    }

    static boolean isPrime(long n) {
        if (n < 2) {
            return false;
        }

        if (n == 2 || n == 3) {
            return true;
        }

        if (n % 2 == 0) {
            return false;
        }

        long d = n - 1;
        int s = 0;

        while (d % 2 == 0) {
            d /= 2;
            s++;
        }

        long[] bases = {2, 3, 5, 7, 11, 13, 17};

        for (long a : bases) {
            if (a >= n) {
                continue;
            }

            long x = power(a, d, n);

            if (x == 1 || x == n - 1) {
                continue;
            }

            boolean passed = false;

            for (int r = 1; r < s; r++) {
                x = x * x % n;

                if (x == n - 1) {
                    passed = true;
                    break;
                }
            }

            if (!passed) {
                return false;
            }
        }

        return true;
    }

    public static void main(String[] args) throws Exception {
        BufferedReader br = new BufferedReader(
                new InputStreamReader(System.in)
        );

        long n = Long.parseLong(br.readLine());

        if (isPrime(n)) {
            System.out.println("YES");
        } else {
            System.out.println("NO");
        }
    }
}
